#!/bin/bash
ARCH="$(/usr/bin/uname -m)"
if [[ "$ARCH" != "arm64" ]]; then
  echo "DSH 桌宠 v0.1 目前只支持 Apple Silicon（arm64）。当前架构：$ARCH" >&2
  exit 1
fi
if [[ ! -d "/Applications/DeepSeek Harness.app" ]]; then
  echo "没有找到 /Applications/DeepSeek Harness.app。请先安装 DeepSeek Harness，再运行桌宠安装包。" >&2
  exit 1
fi
exit 0

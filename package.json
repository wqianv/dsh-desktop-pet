{
  "name": "dsh-desktop-pet",
  "version": "0.3.2",
  "private": true,
  "description": "A true OS-level desktop pet for DeepSeek Harness: transparent, always-on-top overlay + moddable pet packs.",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build --debug --bundles app",
    "build:release": "tauri build --bundles app",
    "open": "bash ./launch.sh",
    "state": "node tools/state-dump.js --watch",
    "preview": "python3 tools/make-pet-preview.py --pack pets/dafeiyu --out docs/pet.png",
    "test": "bash scripts/smoke-test.sh",
    "test:app": "bash scripts/smoke-test.sh --app",
    "doctor": "bash scripts/doctor.sh",
    "package": "bash scripts/package-release.sh --build",
    "package:pkg": "bash scripts/build-installer-pkg.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3"
  }
}